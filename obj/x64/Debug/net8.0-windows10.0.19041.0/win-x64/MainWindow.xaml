<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="IsoSlimmer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IsoSlimmer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="IsoSlimmer">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шаг 1: Поля выбора ISO и папки -->
        <StackPanel x:ConnectionId='2' x:Name="pnlStep1" Grid.Row="0" Spacing="12">
            <!-- ISO -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="ISO:" Width="120" VerticalAlignment="Center"/>
                <TextBox x:ConnectionId='16' x:Name="txtIsoPath" Width="400" IsReadOnly="True"/>
                <Button x:ConnectionId='17' x:Name="btnBrowseIso" Content="Обзор..."                           />
            </StackPanel>

            <!-- Рабочая папка -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Рабочая папка:" Width="120" VerticalAlignment="Center"/>
                <TextBox x:ConnectionId='14' x:Name="txtWorkDir" Width="400" IsReadOnly="True"/>
                <Button x:ConnectionId='15' x:Name="btnBrowseWorkDir" Content="Обзор..."                               />
            </StackPanel>
        </StackPanel>

        <!-- Шаг 2: Остальные поля (скрыты изначально) -->
        <StackPanel x:ConnectionId='3' x:Name="pnlStep2" Grid.Row="1" Spacing="12" Visibility="Collapsed" Margin="0,12,0,0">
            <!-- Имя ISO -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Имя ISO:" Width="120" VerticalAlignment="Center"/>
                <TextBox x:ConnectionId='13' x:Name="txtOutputName" Width="400" PlaceholderText="Win11_Slim.iso"/>
            </StackPanel>

            <!-- Редакция -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Редакция:" Width="120" VerticalAlignment="Center"/>
                <ComboBox x:ConnectionId='12' x:Name="cmbEdition" Width="400" PlaceholderText="Сначала выберите ISO"/>
            </StackPanel>

            <!-- Сжатие -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Сжатие:" Width="120" VerticalAlignment="Center"/>
                <ComboBox x:ConnectionId='11' x:Name="cmbCompression" Width="400" SelectedIndex="0">
                    <ComboBoxItem Content="recovery"/>
                    <ComboBoxItem Content="max"/>
                    <ComboBoxItem Content="fast"/>
                    <ComboBoxItem Content="none"/>
                </ComboBox>
            </StackPanel>

            <!-- Unattended.xml -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Unattended.xml:" Width="120" VerticalAlignment="Center"/>
                <TextBox x:ConnectionId='9' x:Name="txtXmlPath" Width="400" IsReadOnly="True"/>
                <Button x:ConnectionId='10' x:Name="btnBrowseXml" Content="Обзор..."                           />
            </StackPanel>
        </StackPanel>

        <!-- Кнопка Далее / Создать (всегда под полями) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16" Margin="0,20,0,0">
            <Button x:ConnectionId='7' x:Name="btnAction" Content="Далее" Width="160"                        />
            <Button x:ConnectionId='8' x:Name="btnShowConsole" Content="Показать консоль"                              Visibility="Collapsed"/>
        </StackPanel>

        <!-- Прогресс -->
        <StackPanel Grid.Row="3" VerticalAlignment="Bottom" Spacing="8" Margin="0,20,0,0">
            <Grid>
                <ProgressBar x:ConnectionId='5' x:Name="progressBar" Height="16" Value="0" Maximum="100"/>
                <TextBlock x:ConnectionId='6' x:Name="lblProgressPercent" 
                           Text="0%" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           FontSize="16" 
                           FontWeight="Bold"/>
            </Grid>
            <TextBlock x:ConnectionId='4' x:Name="lblStatus" Text="Готов к работе"/>
        </StackPanel>
    </Grid>
</Window>

